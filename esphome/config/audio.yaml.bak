esphome:
  name: korvo-audio
  friendly_name: Korvo Audio
  name_add_mac_suffix: true
  comment: "ESP32-S3-Korvo-1 语音节点，将音频流送入 Home Assistant 管道"

external_components:
  - source:
      type: local
      path: custom_components
esp32:
  cpu_frequency: 240MHz
  board: esp32-s3-devkitc-1
  variant: esp32s3
  framework:
    type: esp-idf
    sdkconfig_options:
      CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ: "240"
      CONFIG_FREERTOS_UNICORE: n
      CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL: "32768"
      # 语音处理依赖更大的缓存与 PSRAM
      CONFIG_ESP32S3_DATA_CACHE_64KB: y
      CONFIG_ESP32S3_SPIRAM_SUPPORT: y

psram:
  mode: octal
  speed: 80MHz

sd_card:
  id: korvo_sd
  clk_pin: 18
  cmd_pin: 17
  d0_pin: 16
  width: 1
  mount_point: /sdcard
  max_files: 5
  format_if_mount_failed: true
  allocation_unit_kb: 16
logger:
  hardware_uart: USB_SERIAL_JTAG
  level: INFO

# Home Assistant API/OTA
api:
  encryption:
    key: !secret api_encryption_key

ota:
  - platform: esphome
    password: !secret ota_password

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  manual_ip:
    # Set this to the IP of the ESP
    static_ip: 192.168.1.42
    # Set this to the IP address of the router. Often ends with .1
    gateway: 192.168.1.1
    # The subnet of the network. 255.255.255.0 works for most home networks.
    subnet: 255.255.255.0
    # Optional: DNS server
    dns1: 192.168.1.1
  ap:
    ssid: "Korvo Audio Fallback"
    password: !secret ap_fallback_password

captive_portal:

globals:
  - id: korvo_mode_idx
    type: int
    restore_value: yes
    initial_value: "0"
  - id: korvo_buttons_last
    type: int
    restore_value: no
    initial_value: "-1"

time:
  - platform: homeassistant
    id: ha_time

korvo_audio:
  sda: 1
  scl: 2
  i2c_frequency: 400000
  pa_pin: 38
  # 与 i2s_audio 扬声器的采样率保持一致，避免编解码器与 I2S 时钟不匹配产生底噪
  speaker_sample_rate: 22050
  speaker_volume:  60
  mic_sample_rate: 16000
  mic_mclk_ratio: 256
  mic_gain: 24DB
  mic_bias: 2V87
  mic_tdm: true

# 两路 I2S：I2S0 -> ES8311 扬声器, I2S1 -> ES7210 麦阵列（依据 esp-bsp/bsp/esp32_s3_korvo_1/include/bsp/esp32_s3_korvo_1.h）
i2s_audio:
  - id: korvo_speaker_bus
    i2s_mclk_pin: GPIO42
    i2s_bclk_pin: GPIO40
    i2s_lrclk_pin: GPIO41
  - id: korvo_mic_bus
    i2s_mclk_pin: GPIO20
    i2s_bclk_pin: GPIO10
    i2s_lrclk_pin: GPIO9

microphone:
  - platform: i2s_audio
    id: korvo_mic
    i2s_audio_id: korvo_mic_bus
    i2s_din_pin: GPIO11
    channel: left
    sample_rate: 16000
    bits_per_sample: 16bit
    pdm: false
    adc_type: external

speaker:
  - platform: i2s_audio
    id: korvo_speaker
    i2s_audio_id: korvo_speaker_bus
    i2s_dout_pin: GPIO39
    dac_type: external
    bits_per_sample: 16bit
    sample_rate: 22050
    timeout: 800ms
  - platform: mixer
    id: korvo_mixer
    output_speaker: korvo_speaker
    source_speakers:
      # 增大缓冲避免启动与换源时下溢导致的噪声
      - id: announcement_spk_mixer_input
        buffer_duration: 350ms
        timeout: 2s
      - id: media_spk_mixer_input
        buffer_duration: 200ms
        timeout: 2s

  - platform: resampler
    id: media_spk_resampling_input
    output_speaker: media_spk_mixer_input
    buffer_duration: 300ms
    num_channels: 1
    bits_per_sample: 16
    sample_rate: 22050
    filters: 32
    taps: 32

  - platform: resampler
    id: announcement_spk_resampling_input
    output_speaker: announcement_spk_mixer_input
    bits_per_sample: 16
    sample_rate: 22050
    filters: 32
    taps: 32
    # 初始几帧延迟，避免第一包数据过短造成啸叫/咔嗒
    # 同时作为抖动缓冲，针对 TTS 流适度放大
    num_channels: 1
    buffer_duration: 400ms

# 可以从 HA 面板触发 Push-to-talk
sensor:
  - platform: adc
    id: korvo_buttons_adc
    pin: GPIO8
    attenuation: 12db
    update_interval: 20ms
    filters:
      - sliding_window_moving_average:
          window_size: 5
          send_every: 1
    on_value:
      then:
        - lambda: |-
            const float mv = id(korvo_buttons_adc).state * 1000.0f;
            auto in = [&](float v, float lo, float hi){ return v >= lo && v <= hi; };
            int key = -1;
            if      (in(mv, 2310, 2510)) key = 0;  // REC/PTT
            else if (in(mv, 1880, 2080)) key = 1;  // MODE
            else if (in(mv, 1560, 1760)) key = 2;  // PLAY
            else if (in(mv, 1010, 1210)) key = 3;  // SET
            else if (in(mv,  720,  920)) key = 4;  // VOLDOWN
            else if (in(mv,  280,  480)) key = 5;  // VOLUP
            if (key >= 0 && key != id(korvo_buttons_last)) {
              id(korvo_buttons_last) = key;
              switch (key) {
                case 0:
                  id(korvo_ptt).press();
                  break;
                case 4:
                  id(ha_call_vol_down).execute();
                  break;
                case 5:
                  id(ha_call_vol_up).execute();
                  break;
                case 1:
                  id(ha_mode_cycle).execute();
                  break;
                case 2:
                  id(ha_call_play_pause).execute();
                  break;
                case 3:
                  id(ha_call_stop).execute();
                  break;
              }
            }

script:
  - id: ha_call_vol_up
    then:
      - homeassistant.service:
          service: media_player.volume_up
          data:
            entity_id: media_player.korvo_media
  - id: ha_call_vol_down
    then:
      - homeassistant.service:
          service: media_player.volume_down
          data:
            entity_id: media_player.korvo_media
  - id: ha_call_play_pause
    then:
      - homeassistant.service:
          service: media_player.media_play_pause
          data:
            entity_id: media_player.korvo_media
  - id: ha_call_stop
    then:
      - homeassistant.service:
          service: media_player.media_stop
          data:
            entity_id: media_player.korvo_media
  - id: ha_mode_cycle
    then:
      - lambda: |-
          int m = id(korvo_mode_idx);
          m = (m + 1) % 2;  // 0: low-latency, 1: stable
          id(korvo_mode_idx) = m;
      - if:
          condition:
            lambda: 'return id(korvo_mode_idx) == 0;'
          then:
            - light.addressable_set:
                id: korvo_ring
                range_from: 0
                range_to: 11
                red: 0%
                green: 0%
                blue: 100%
            - homeassistant.event:
                event: esphome.korvo_profile
                data:
                  profile: low_latency
          else:
            - light.addressable_set:
                id: korvo_ring
                range_from: 0
                range_to: 11
                red: 0%
                green: 100%
                blue: 0%
            - homeassistant.event:
                event: esphome.korvo_profile
                data:
                  profile: stable
  - id: ha_evt_btn_mode
    then:
      - homeassistant.event:
          event: esphome.korvo_button
          data:
            key: MODE
  - id: ha_evt_btn_play
    then:
      - homeassistant.event:
          event: esphome.korvo_button
          data:
            key: PLAY
  - id: ha_evt_btn_set
    then:
      - homeassistant.event:
          event: esphome.korvo_button
          data:
            key: SET

button:
  - platform: template
    name: "SD Write Test"
    on_press:
      - logger.log: "[SD] Write test start"
      - lambda: |-
          FILE *f = fopen("/sdcard/esphome_test.txt", "w");
          if (!f) {
            ESP_LOGE("sdtest", "open failed - SD not mounted?");
          } else {
            const char *msg = "hello from esphome";
            fwrite(msg, 1, strlen(msg), f);
            fclose(f);
            ESP_LOGI("sdtest", "write ok");
          }
  - platform: template
    name: "SD Read Test"
    on_press:
      - logger.log: "[SD] Read test start"
      - lambda: |-
          FILE *f = fopen("/sdcard/esphome_test.txt", "r");
          if (!f) {
            ESP_LOGE("sdtest", "open failed - file missing or SD not mounted");
          } else {
            char buf[64] = {0};
            size_t n = fread(buf, 1, sizeof(buf)-1, f);
            fclose(f);
            ESP_LOGI("sdtest", "read %u bytes: %s", (unsigned)n, buf);
          }
  - platform: template
    name: "Speaker Beep Test"
    on_press:
      - speaker.play:
          id: announcement_spk_mixer_input
          data: !lambda |-
            const int sr = 22050;
            const float freq = 1000.0f;
            const int dur_ms = 300;
            const int n = sr * dur_ms / 1000;
            std::vector<uint8_t> out;
            out.reserve(n * 2);
            for (int i = 0; i < n; i++) {
              float s = sinf(2.0f * 3.1415926f * freq * i / sr);
              int16_t v = (int16_t)(s * 12000);
              out.push_back((uint8_t)(v & 0xFF));
              out.push_back((uint8_t)((v >> 8) & 0xFF));
            }
            return out;
  - platform: template
    name: "Korvo 语音录入"
    id: korvo_ptt
    on_press:
      - voice_assistant.start:
          id: korvo_assistant
light:
  - platform: esp32_rmt_led_strip
    id: korvo_ring
    name: "Korvo Ring"
    pin: GPIO19
    num_leds: 12
    chipset: WS2812
    rgb_order: GRB

voice_assistant:
  id: korvo_assistant
  microphone: korvo_mic
  speaker: announcement_spk_resampling_input
  auto_gain: 31dBFS        # Korvo 阵列默认增益
  noise_suppression_level: 3
  use_wake_word: false     # 先用手动 PTT，后续可换唤醒词
  on_start:
    - light.turn_on:
        id: korvo_ring
        brightness: 80%
        red: 0%
        green: 0%
        blue: 100%
    - logger.log: "开始录音并推送到 Home Assistant 管道"
  on_listening:
    - light.addressable_set:
        id: korvo_ring
        range_from: 0
        range_to: 11
        red: 0%
        green: 100%
        blue: 0%
    - logger.log: "流式语音 -> STT"
  on_stt_end:
    - repeat:
        count: 2
        then:
          - light.addressable_set:
              id: korvo_ring
              range_from: 0
              range_to: 11
              red: 0%
              green: 100%
              blue: 100%
          - delay: 150ms
          - light.turn_off: korvo_ring
          - delay: 150ms
    - logger.log: "Home Assistant STT 返回结果"
  on_error:
    - light.addressable_set:
        id: korvo_ring
        range_from: 0
        range_to: 11
        red: 100%
        green: 0%
        blue: 0%
    - homeassistant.event:
        event: esphome.korvo_voice_error
        data:
          code: !lambda 'return code;'
          message: !lambda 'return message;'
    - logger.log:
        level: ERROR
        format: "Voice assistant error: %s"
        args:
          - message.c_str()
  on_end:
    - light.turn_off:
        id: korvo_ring
        transition_length: 800ms
    - logger.log: "录音完成"


media_player:
  - platform: speaker
    id: korvo_media
    name: Korvo Media Player
    media_pipeline:
      speaker: media_spk_resampling_input
      num_channels: 1
    announcement_pipeline:
      speaker: announcement_spk_resampling_input
      num_channels: 1
