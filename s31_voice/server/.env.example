# 复制成 .env 后填写。.env 已在 .gitignore 里，不会进仓库。
HA_URL=http://127.0.0.1:8123
# HA -> 左下角头像 -> 安全 -> 长期访问令牌 -> 创建
HA_TOKEN=
# 留空则自动选第一个 light.*；配好小米集成后填成麦希瑟那只，例如 light.myrkisel_e27
LIGHT_ENTITY=

STT_MODEL=iic/SenseVoiceSmall
STT_DEVICE=cpu
# 音色**测出来的**，别凭好听挑：tools/voice_bench.py 用设备真会念的回话
# 合成后再让 SenseVoice 转写回来逐字比对。zm_011 整句 12/15，发音零错。
# 权重是 Kokoro 的中文专版 v1.1-zh（tools/fetch_tts_model.sh 拉），
# 不是通用 v1.0 —— 后者中文音色项目自评 C/D，「灯开了」会念成「登台了」。
TTS_VOICE=zm_011
TTS_SPEED=1.0

HOST=0.0.0.0
PORT=8790

# 你的 ~/.cache/huggingface/token 是个失效的旧 token（2026-03 的），
# huggingface_hub 会带着它去请求公开仓库，然后被 401 拒掉。
# 指到一个不存在的路径就相当于"不带 token"，不用删你的原文件。
# 想彻底解决就去 https://huggingface.co/settings/tokens 重新生成再 huggingface-cli login。
HF_TOKEN_PATH=/nonexistent/hf_token

# 局域网共享令牌。除 /health 外所有接口都要 Authorization: Bearer <这个值>。
# 板子那边写在 firmware/sdkconfig.secret 的 CONFIG_S31_API_TOKEN，两边必须一致。
# 生成：python3 -c 'import secrets;print(secrets.token_hex(16))'
# 留空 = 关掉鉴权。
API_TOKEN=
