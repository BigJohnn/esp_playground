# 复制成 sdkconfig.secret 并填上真实值。这个文件不进仓库。
CONFIG_S31_WIFI_SSID="你的 Wi-Fi 名字"
CONFIG_S31_WIFI_PASSWORD="你的 Wi-Fi 密码"
# 服务端一般靠 UDP 广播自动发现，这里留空即可；广播被网络拦掉时才需要写死。
CONFIG_S31_SERVER_HOST=""
# 和 server/.env 的 API_TOKEN 必须一字不差。留空 = 两边都不鉴权。
# 生成：python3 -c 'import secrets;print(secrets.token_hex(16))'
CONFIG_S31_API_TOKEN=""
